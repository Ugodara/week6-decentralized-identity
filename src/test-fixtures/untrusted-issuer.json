// create-untrusted-issuer-fixture.js
// Generates a credential that is otherwise perfectly valid (right type,
// audience, claims, status, real signature) but signed by an issuer that is
// NOT the one trusted in policy.json. Used to test the ISSUER_UNTRUSTED
// deny path — proves the verifier checks issuer identity, not just "is this
// signed by someone".
//
// Dependencies: npm install @noble/ed25519 @noble/hashes multiformats
// Usage: node src/create-untrusted-issuer-fixture.js

import { readFileSync, writeFileSync, mkdirSync } from 'fs';
import * as ed25519 from '@noble/ed25519';
import { sha512 } from '@noble/hashes/sha2.js';
import { base58btc } from 'multiformats/bases/base58';

ed25519.hashes.sha512 = sha512;

const POLICY_PATH = './src/policy.json';
const OUT_PATH = 'src/test-fixtures/untrusted-issuer.json';

function loadPolicy() {
  return JSON.parse(readFileSync(POLICY_PATH, 'utf8'));
}

function didFromPublicKey(pubBytes) {
  const bytes = new Uint8Array(2 + pubBytes.length);
  bytes.set([0xed, 0x01], 0);
  bytes.set(pubBytes, 2);
  return 'did:key:' + base58btc.encode(bytes);
}

async function main() {
  const policy = loadPolicy();

  // A brand-new, throwaway keypair — deliberately NOT the one in
  // policy.json's acceptedIssuer. Not persisted to private/, since this
  // "issuer" has no legitimate standing and never should be reused.
  const rogueSecret = ed25519.utils.randomSecretKey();
  const rougePub = await ed25519.getPublicKeyAsync(rogueSecret);
  const rogueDid = didFromPublicKey(rougePub);

  if (rogueDid === policy.acceptedIssuer) {
    throw new Error('Collision: generated a DID that matches the trusted issuer — rerun.');
  }

  const unsigned = {
    '@context': ['https://www.w3.org/2018/credentials/v1'],
    type: ['VerifiableCredential', policy.acceptedType],
    issuer: rogueDid,
    audience: policy.audience,
    issuanceDate: new Date().toISOString(),
    credentialStatus: { status: policy.requiredStatus },
    credentialSubject: {
      id: 'did:key:zHOLDER_TEST',
      course: 'week6',
      cohort: 'cohort-2',
      status: policy.requiredStatus
    }
  };

  const message = Buffer.from(JSON.stringify(unsigned));
  const signature = await ed25519.signAsync(message, rogueSecret);

  const credential = {
    ...unsigned,
    proof: {
      type: 'Ed25519Signature2020',
      created: new Date().toISOString(),
      verificationMethod: rogueDid,
      signatureValue: Buffer.from(signature).toString('hex')
    }
  };

  mkdirSync('src/test-fixtures', { recursive: true });
  writeFileSync(OUT_PATH, JSON.stringify(credential, null, 2));

  console.log(`Fixture written to ${OUT_PATH}`);
  console.log(`Rogue issuer DID (NOT trusted by policy.json): ${rogueDid}`);
  console.log(`Policy's actual trusted issuer:                ${policy.acceptedIssuer}`);
}

main().catch(err => {
  console.error(`Fixture generation failed: ${err.message}`);
  process.exit(1);
});